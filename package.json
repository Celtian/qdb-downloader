{
  "name": "qdb-downloader",
  "version": "0.0.24",
  "description": "Create date-based football-data snapshots from supported online sources",
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz",
    "url": "https://github.com/Celtian"
  },
  "homepage": "https://github.com/Celtian/qdb-downloader#readme",
  "bugs": {
    "url": "https://github.com/Celtian/qdb-downloader/issues"
  },
  "main": ".electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "create-version": "package-version-info -o projects/version-info.ts",
    "flags:build": "flag-resizer",
    "start": "bun run build:electron && concurrently --kill-others --names renderer,desktop \"bun run start:renderer\" \"bun run start:desktop\"",
    "start:renderer": "ng serve electron --host 127.0.0.1 --port 4200 --prebundle=false",
    "start:desktop": "wait-on http://127.0.0.1:4200 .electron/electron/main.js .electron/electron/preload.js && cross-env ELECTRON_RUN_AS_NODE= QDB_RENDERER_URL=http://127.0.0.1:4200 electron .",
    "start:docs": "ng serve docs",
    "build": "bun run --parallel build:renderer build:docs build:electron",
    "build:renderer": "ng build electron",
    "build:docs": "ng build docs --base-href /qdb-downloader/",
    "build:electron": "tsc -p projects/electron/tsconfig.electron.json",
    "forge": "cross-env npm_config_user_agent=npm/11.16.0 electron-forge",
    "package:desktop": "bun run build:renderer && bun run build:electron && bun run forge package",
    "release:windows": "bun run build:renderer && bun run build:electron && bun run forge make --platform=win32 --arch=x64",
    "typecheck": "bun run --parallel typecheck:renderer typecheck:docs typecheck:electron",
    "typecheck:renderer": "ng build electron --configuration development",
    "typecheck:docs": "ng build docs --configuration development --base-href /qdb-downloader/",
    "typecheck:electron": "tsc -p projects/electron/tsconfig.electron.json --noEmit",
    "lint": "bun run --parallel 'lint:*'",
    "lint:angular": "ng lint",
    "lint:styles": "stylelint 'projects/**/*.css'",
    "lint:tooling": "eslint --cache --cache-location .angular/cache/eslint/tooling --cache-strategy content --max-warnings=0 'tools/**/*.ts' '*.ts' '*.cjs'",
    "check-circular-dependencies": "madge --circular --extensions ts --ts-config tsconfig.json projects/docs/src projects/electron/src projects/electron/electron projects/electron/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --parallel test:renderer test:docs test:tools",
    "test:renderer": "ng test electron --watch=false",
    "test:docs": "ng test docs --watch=false",
    "test:tools": "vitest run --config tools/vitest.config.ts",
    "test:coverage": "bun run --parallel test:coverage:renderer test:coverage:docs test:coverage:tools",
    "test:coverage:renderer": "ng test electron --watch=false --coverage",
    "test:coverage:docs": "ng test docs --watch=false --coverage",
    "test:coverage:tools": "vitest run --coverage --config tools/vitest.config.ts",
    "test:coverage:ci": "bun run --parallel test:coverage:ci:renderer test:coverage:ci:docs test:coverage:ci:tools",
    "test:coverage:ci:renderer": "ng test electron --watch=false --coverage --coverage-reporters=text-summary",
    "test:coverage:ci:docs": "ng test docs --watch=false --coverage --coverage-reporters=text-summary",
    "test:coverage:ci:tools": "vitest run --coverage --config tools/vitest.config.ts --coverage.reporter=text-summary",
    "validate:source": "bun run format:check && bun run lint && bun run typecheck",
    "validate": "bun run check-circular-dependencies && bun run validate:source && bun run test",
    "changelog": "auto-changelog -p",
    "version": "bun run create-version && bun run changelog && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛\"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥\"",
    "prepare": "husky && bun run create-version"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@fontsource/roboto": "^5.3.0",
    "express": "^5.2.1",
    "material-icons": "^1.13.14",
    "ngx-app-version": "^3.0.1",
    "ngx-nullable": "^1.0.1",
    "rxjs": "~7.8.2",
    "soccerbot": "^1.4.0",
    "tslib": "^2.8.1",
    "update-electron-app": "3.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.3",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "auto-changelog": "2.6.0",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "flag-resizer": "^0.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "package-version-info": "^0.3.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "quick-commitlint": "^0.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "auto-changelog": {
    "remote": "none",
    "commitUrl": "https://github.com/Celtian/qdb-downloader/commit/{id}",
    "issueUrl": "https://github.com/Celtian/qdb-downloader/issues/{id}",
    "mergeUrl": "https://github.com/Celtian/qdb-downloader/pull/{id}",
    "compareUrl": "https://github.com/Celtian/qdb-downloader/compare/{from}...{to}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celtian/qdb-downloader.git"
  },
  "engines": {
    "node": ">=24.18 <25",
    "npm": "please-use-bun"
  },
  "patchedDependencies": {
    "eslint-plugin-tailwindcss@4.2.0": "patches/eslint-plugin-tailwindcss@4.2.0.patch"
  }
}
